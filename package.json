{
  "name": "geotv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --watch --env-file-if-exists=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "format": "prettier --write server web tests scripts docs README.md package.json",
    "format:check": "prettier --check server web tests scripts docs README.md package.json",
    "setup": "node scripts/setup.mjs"
  },
  "devDependencies": {
    "pdf-lib": "1.17.1",
    "prettier": "3.9.6"
  },
  "dependencies": {
    "pdfjs-dist": "6.3.289"
  }
}
