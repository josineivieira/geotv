PORT=3000
HOST=127.0.0.1
# Configure antes de iniciar. Sem senha padrão.
GEOTV_ADMIN_EMAIL=admin@geotv.local
GEOTV_ADMIN_PASSWORD=
GEOTV_ADMIN_NAME=Administrador
# Em produção, usar HTTPS e definir a origem pública exata.
PUBLIC_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# Banco: em branco usa SQLite; aceita PostgreSQL ou mongodb+srv://.../geotv.
# No Render, DATABASE_URL é obrigatória.
DATABASE_URL=
# Destino usado somente pelo comando migrate:mongodb; não ativa o banco.
MONGODB_URI=
# URL HTTPS do projeto Supabase (não é o endereço do Render).
SUPABASE_URL=
# Chave secreta de servidor. Nunca colocar no frontend ou no GitHub.
SUPABASE_SECRET_KEY=
# Alternativa legada à chave acima: service_role.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=geotv-media
# Opcional: certificado CA PEM do banco, se exigido; aceita \n escapado.
DATABASE_CA_CERT=
